@article{landyParameterizationCentimeterScaleSea2015,
  title = {Parameterization of {{Centimeter-Scale Sea Ice Surface Roughness Using Terrestrial LiDAR}}},
  author = {Landy, Jack C. and Isleifson, Dustin and Komarov, Alexander S. and Barber, David G.},
  year = 2015,
  month = mar,
