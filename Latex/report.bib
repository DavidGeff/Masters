@inproceedings{sandruShipborneSeaiceField2021,
  title = {Shipborne Sea-Ice Field Mapping Using a {{LiDAR}}},
  booktitle = {2021 {{IEEE}}/{{RSJ International Conference}} on {{Intelligent Robots}} and {{Systems}} ({{IROS}})},
