@article{doblePancakeIceFormation2003,
  title = {Pancake Ice Formation in the {{Weddell Sea}}},
  author = {Doble, M. J. and Coon, M. D. and Wadhams, P.},
  year = 2003,
  month = jul,
  journal = {Journal of Geophysical Research: Oceans},
  volume = {108},
  number = {C7},
  pages = {2002JC001373},
  issn = {0148-0227},
  doi = {10.1029/2002JC001373},
  urldate = {2024-04-09},
  abstract = {The ice formation resulting from two low temperature events at the Weddell Sea ice edge during April 2000 is presented. Pancake and frazil ice were sampled at seven stations at varying distances from the ice edge. The ice cover was further characterized from above, using helicopter aerial photography, and from below, using a remotely operated vehicle. Previously undescribed two-layer pancake types were observed and classified. A novel pancake growth mechanism is introduced to account for these, involving the washing of frazil ice over the pancake top surface and its subsequent freezing. The process was directly observed in ice tank experiments. Layer thicknesses seen in the field were compared to the ice growth that would occur both under calm conditions and from free-surface frazil ice growth. Classical, bottom accretion, pancake growth was found to proceed at a rate similar to that of thin congelation ice. Top-layer growth was more rapid, at approximately double the congelation rate. Overall ice volume production was similar to congelation ice for the thin pancakes considered ({$\sim$}20 cm), though subsequent thickening was expected to be faster as the rapid top-layer process continued and the equivalent congelation growth slowed. It is suggested that parameterization of this new process is important for models that aim to simulate the rapid advance and thickening of wave-influenced ice covers.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english}
}

