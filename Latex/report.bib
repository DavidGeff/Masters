@article{zakhvatkinaSatelliteSARDatabased2019,
  title = {Satellite {{SAR Data-based Sea Ice Classification}}: {{An Overview}}},
  shorttitle = {Satellite {{SAR Data-based Sea Ice Classification}}},
  author = {Zakhvatkina, N. and Smirnov, V. and Bychkova, I.},
  year = 2019,
  month = mar,
  journal = {Geosciences},
  volume = {9},
  number = {4},
  pages = {152},
  issn = {2076-3263},
  doi = {10.3390/geosciences9040152},
  urldate = {2025-11-24},
  abstract = {A review of the main approaches developed for sea ice classification using satellite imagery is presented. Satellite data are the main and very often only information source for sea ice classification and charting in the remote arctic regions. The main techniques used for ice classification and ice charting in several national ice services are considered. Advantages and disadvantages of various SAR data-based methods for ice classification are analyzed. It is shown that an increase of SAR technical abilities contributes to the enhancement of sea ice classification reliability. The possible further development of satellite data-based methods for ice classification is discussed.},
  langid = {english}
}

