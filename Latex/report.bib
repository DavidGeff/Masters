@article{doblePancakeIceFormation2003,
  title = {Pancake Ice Formation in the {{Weddell Sea}}},
  author = {Doble, Martin J. and Coon, Max D. and Wadhams, Peter},
  year = 2003,
  month = jul,
  journal = {Journal of Geophysical Research: Oceans},
  volume = {108},
  number = {C7},
  pages = {2002JC001373},
  issn = {0148-0227},
  doi = {10.1029/2002JC001373},
  urldate = {2024-04-09},
  abstract = {The ice formation resulting from two low temperature events at the Weddell Sea ice edge during April 2000 is presented. Pancake and frazil ice were sampled at seven stations at varying distances from the ice edge. The ice cover was further characterized from above, using helicopter aerial photography, and from below, using a remotely operated vehicle. Previously undescribed two-layer pancake types were observed and classified. A novel pancake growth mechanism is introduced to account for these, involving the washing of frazil ice over the pancake top surface and its subsequent freezing. The process was directly observed in ice tank experiments. Layer thicknesses seen in the field were compared to the ice growth that would occur both under calm conditions and from free-surface frazil ice growth. Classical, bottom accretion, pancake growth was found to proceed at a rate similar to that of thin congelation ice. Top-layer growth was more rapid, at approximately double the congelation rate. Overall ice volume production was similar to congelation ice for the thin pancakes considered ({$\sim$}20 cm), though subsequent thickening was expected to be faster as the rapid top-layer process continued and the equivalent congelation growth slowed. It is suggested that parameterization of this new process is important for models that aim to simulate the rapid advance and thickening of wave-influenced ice covers.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english}
}

@article{dobleRelatingWaveAttenuation2015,
  title = {Relating Wave Attenuation to Pancake Ice Thickness, Using Field Measurements and Model Results},
  author = {Doble, Martin J. and De Carolis, Giacomo and Meylan, Michael H. and Bidlot, Jean-Raymond and Wadhams, Peter},
  year = 2015,
  month = jun,
  journal = {Geophysical Research Letters},
  volume = {42},
  number = {11},
  pages = {4473--4481},
  issn = {0094-8276, 1944-8007},
  doi = {10.1002/2015GL063628},
  urldate = {2025-02-24},
  abstract = {Abstract                            Wave attenuation coefficients (               {$\alpha$}               , m               -1               ) were calculated from in situ data transmitted by custom wave buoys deployed into the advancing pancake ice region of the Weddell Sea. Data cover a 12\,day period as the buoy array was first compressed and then dilated under the influence of a passing low-pressure system. Attenuation was found to vary over more than 2 orders of magnitude and to be far higher than that observed in broken-floe marginal ice zones. A clear linear relation between               {$\alpha$}               and ice thickness was demonstrated, using ice thickness from a novel dynamic/thermodynamic model. A simple expression for               {$\alpha$}               in terms of wave period and ice thickness was derived, for application in research and operational models. The variation of               {$\alpha$}               was further investigated with a two-layer viscous model, and a linear relation was found between eddy viscosity in the sub-ice boundary layer and ice thickness.                        ,              Key Points                                                                Linear relation found between wave attenuation and pancake ice thickness                                                     Linear relation found between eddy viscosity and ice thickness in viscous model                                                     Simple expression derived to calculate attenuation at any period},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english},
  file = {C\:\\Users\\dseph\\Zotero\\storage\\3XMIUXVH\\Doble et al. - 2015 - Relating wave attenuation to pancake ice thickness, using field measurements and model results.pdf;C\:\\Users\\dseph\\Zotero\\storage\\G2JYC4SH\\Doble et al. - 2015 - Relating wave attenuation to pancake ice thickness, using field measurements and model results.pdf}
}

